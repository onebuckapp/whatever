config({
  commands: {
    run: "make run && open '$PWD/macos/Build/Build/Products/Debug/Whatever.app'",
    build_core: "clue build core/nim-core/browsercore.nim -d:release --app:staticlib --out:build/libbrowsercore.a"
    macos_test: "cd macos && xcodebuild test -project Whatever.xcodeproj -scheme Whatever -destination 'platform=macOS' -parallel-testing-enabled NO"
  }
})