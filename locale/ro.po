msgid "The second press quits at once, even with windows open."
msgstr "A doua apăsare închide imediat, chiar și cu ferestre deschise."

msgctxt "Settings.General"
msgid "Confirm before quitting"
msgstr "Confirmă înainte de închidere"

msgctxt "Settings.General"
msgid "First ⌘Q shows a prompt; press ⌘Q again to quit."
msgstr "Prima apăsare ⌘Q arată o confirmare; apasă ⌘Q din nou pentru a închide."

msgctxt "Settings.General"
msgid "History"
msgstr "Istoric"

msgctxt "Settings.General"
msgid "Private tabs are never recorded, whatever this says."
msgstr "Filele private nu sunt înregistrate niciodată, indiferent ce spune asta."

