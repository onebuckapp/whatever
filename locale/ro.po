msgctxt "Settings.General"
msgid "Software Update"
msgstr "Actualizare software"

msgctxt "Settings.General"
msgid "Whatever never updates itself. Checking asks GitHub for the latest release; downloading fetches its disk image for this Mac, and updating from it stays in your hands."
msgstr "Whatever nu se actualizează singur. Verificarea cere GitHub-ului cea mai recentă versiune; descărcarea aduce imaginea de disc pentru acest Mac, iar actualizarea din ea rămâne în mâinile tale."

msgctxt "Settings.General"
msgid "Default Browser"
msgstr "Browser implicit"

msgctxt "Settings.General"
msgid "Links clicked in other apps open here."
msgstr "Legăturile accesate din alte aplicații se deschid aici."

msgctxt "Settings.General"
msgid "Whatever is your default browser"
msgstr "Whatever este browserul tău implicit"

msgctxt "Settings.General"
msgid "Whatever is not your default browser"
msgstr "Whatever nu este browserul tău implicit"

msgctxt "Settings.General"
msgid "This Mac already opens web links in Whatever."
msgstr "Acest Mac deschide deja legăturile web în Whatever."

msgctxt "Settings.General"
msgid "Claim http and https links from your current browser."
msgstr "Preia legăturile http și https de la browserul tău actual."

msgctxt "Settings.General"
msgid "Set Whatever as Default Browser"
msgstr "Folosește Whatever ca browser implicit"

msgctxt "Settings.General"
msgid "Session"
msgstr "Sesiune"

msgctxt "Settings.General"
msgid "Restoring reopens the previous window's tabs."
msgstr "Restaurarea redeschide filele ferestrei anterioare."

