# Whatever Linux shell — Made by Humans from OpenPeeps (GPLv3)
version = "0.1.0"
author = "George Lemon"
description = "Whatever Linux shell: GTK4 + Adwaita + WebKitGTK 6.0, reusing the portable Nim core"
license = "GPL-3.0-or-later"
srcDir = "src"

requires "nim >= 2.2.10"
requires "openparser >= 0.3.8"
requires "boogie >= 0.2.1"
requires "nimcypher >= 0.2.0"
requires "blackpaper >= 0.2.0"
